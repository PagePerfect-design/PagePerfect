% Minimal — "This is The Source Code"
% Radical Compatibility — compiles anywhere, zero extra dependencies
% Latin Modern (Knuthian Ideal), wide margins, pure content focus
% Target: Drafts, screenplays, documentation, submissions, BasicTeX systems

\documentclass[12pt]{article}
\usepackage{geometry}
\usepackage{setspace}
\usepackage{hyperref}
\usepackage{lmodern}

% ── TYPOGRAPHY — Latin Modern (Computer Modern perfected) ───
% No fontspec required — works on pdflatex, xelatex, lualatex
\setstretch{1.5}
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\hyphenpenalty=500

% ── HEADINGS — Standard LaTeX, tightened ────────────────────
\makeatletter
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.5ex \@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus.2ex}%
  {\normalfont\Large\bfseries\sffamily}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-2ex\@plus -1ex \@minus -.2ex}%
  {1ex \@plus .2ex}%
  {\normalfont\large\bfseries\sffamily}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex\@plus -0.5ex \@minus -.2ex}%
  {0.5ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries}}
\makeatother

% ── NAVIGATION — Empty header, centered page number ────────
\pagestyle{plain}

% ── HYPERLINKS ──────────────────────────────────────────────
\hypersetup{
  colorlinks=true,
  linkcolor=blue!70!black,
  urlcolor=blue!70!black,
  citecolor=blue!70!black
}

$if(title)$
\title{$title$}
$if(author)$\author{$author$}$endif$
\date{$if(date)$$date$$else$$endif$}
$endif$

% ── Header includes (injected by compile pipeline) ─────────
$for(header-includes)$
$header-includes$
$endfor$

\begin{document}

$if(title)$
\maketitle
$endif$

$body$

$if(bibliography)$
\newpage
\section*{References}
$bibliography$
$endif$

\end{document}
