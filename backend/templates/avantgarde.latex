% Avant-Garde — "This is a Manifesto"
% Deconstructed Grid — Ray Gun, Emigre, David Carson meets 2020s Brutalism
% Source Sans 3 body + bold display, rotated elements, radical asymmetry
% Target: Zines, manifestos, lookbooks, art-school publications

\documentclass[11pt]{book}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}
\usepackage{ragged2e}
\usepackage{graphicx}

% ── TYPOGRAPHY — Art School Tension ─────────────────────────
% Source Sans 3: idiosyncratic humanist sans with attitude
\setmainfont{Source Sans 3}[Ligatures=TeX]
\setsansfont{DejaVu Sans}[Scale=MatchLowercase]
\setmonofont{TeX Gyre Cursor}[Scale=MatchLowercase]

% Wild ragged right — no hyphenation, let the rag breathe
\RaggedRight
\hyphenpenalty=10000

% ── SPACING — Block paragraphs with glitch separators ───────
\setstretch{1.35}
\setlength{\parindent}{0pt}
\setlength{\parskip}{10pt}

% ── COLORS ──────────────────────────────────────────────────
\definecolor{ghostnum}{gray}{0.90}

% ── CHAPTER HEADINGS — Deconstructed ────────────────────────
% Massive outlined number behind text + rotated title concept
\titleformat{\chapter}[display]
  {\normalfont\raggedright}
  {\vspace*{36pt}{\fontsize{120pt}{120pt}\selectfont\bfseries\color{ghostnum}\thechapter}}
  {-60pt}
  {\fontsize{20pt}{24pt}\selectfont\bfseries\MakeUppercase}

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\raggedright}
  {\vspace*{36pt}}
  {0pt}
  {\fontsize{20pt}{24pt}\selectfont\bfseries\MakeUppercase}

\titlespacing*{\chapter}{0pt}{0pt}{20pt}

% Section headers — aggressive, uppercase
\titleformat{\section}
  {\normalfont\sffamily\bfseries\fontsize{14pt}{17pt}\selectfont\MakeUppercase}
  {}{0em}{}
\titleformat{\subsection}
  {\normalfont\sffamily\bfseries\normalsize}{}{0em}{}
\titlespacing*{\section}{0pt}{18pt}{6pt}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}

% ── HEADERS & FOOTERS ──────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\footnotesize\sffamily\bfseries\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\sffamily\bfseries\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── BLOCK QUOTES — Brutalist ────────────────────────────────
\renewenvironment{quote}
  {\par\vspace{6pt}\noindent{\color{black}\rule{\textwidth}{2pt}}\par\vspace{4pt}%
   \bfseries\large\setstretch{1.1}}
  {\par\vspace{4pt}\noindent{\color{black}\rule{\textwidth}{2pt}}\par\vspace{6pt}}

\setlist{nosep,leftmargin=1em}
\hypersetup{colorlinks=true,linkcolor=black,urlcolor=black,citecolor=black}

% ── Header includes (injected by compile pipeline) ─────────
$for(header-includes)$
$header-includes$
$endfor$

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\begin{titlepage}
\vspace*{72pt}
\begin{flushleft}
{\fontsize{48pt}{52pt}\selectfont\bfseries\MakeUppercase{$title$}\par}
\vspace{4pt}
\noindent{\color{black}\rule{3cm}{4pt}}
$if(author)$\vspace{16pt}\par{\large\sffamily $author$\par}$endif$
$if(date)$\vspace{6pt}{\footnotesize\sffamily\MakeUppercase{$date$}\par}$endif$
\end{flushleft}
\vspace*{\fill}
\end{titlepage}
$endif$

$body$

$if(bibliography)$
\newpage
\section*{References}
$bibliography$
$endif$

\end{document}
