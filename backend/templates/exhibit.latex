% Exhibit — "This is a Gallery Space"
% White Cube philosophy — MoMA, Tate Modern, Kinfolk aesthetic
% Fira Sans body + TeX Gyre Adventor display, extreme whitespace, matte ink
% Target: Photography books, portfolios, modern poetry, art catalogs

\documentclass[10pt]{book}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}
\usepackage{ragged2e}

% ── TYPOGRAPHY — Museum Geometric Humanist ──────────────────
% Body: Fira Sans — high x-height, open counters, reads cleanly at small sizes
\setmainfont{Fira Sans}[Scale=0.95,Ligatures=TeX]
\setsansfont{TeX Gyre Adventor}[Scale=MatchLowercase,Ligatures=TeX]
\setmonofont{Fira Mono}[Scale=MatchLowercase]

% Absolute ragged right — the gallery wall does not justify
\RaggedRight
\hyphenpenalty=10000

% ── SPACING — Generous "placard" rhythm ─────────────────────
\setstretch{1.5}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.2in}

% ── COLORS ──────────────────────────────────────────────────
\definecolor{ghostgrey}{gray}{0.80}
\definecolor{captiongrey}{gray}{0.45}

% ── CHAPTER HEADINGS — Giant UltraLight Number + Label ──────
\titleformat{\chapter}[display]
  {\normalfont\raggedright}
  {\vspace*{72pt}{\fontsize{80pt}{80pt}\selectfont\sffamily\fontseries{l}\selectfont\color{ghostgrey}\thechapter}}
  {24pt}
  {\fontsize{14pt}{18pt}\selectfont\sffamily\addfontfeature{LetterSpace=15}\MakeUppercase}

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\raggedright}
  {\vspace*{72pt}}
  {0pt}
  {\fontsize{14pt}{18pt}\selectfont\sffamily\addfontfeature{LetterSpace=15}\MakeUppercase}

\titlespacing*{\chapter}{0pt}{0pt}{40pt}

% Section headers — tiny, uppercase, tracked, no bold
\titleformat{\section}
  {\vspace{28pt}\normalfont\fontsize{10pt}{13pt}\selectfont\sffamily\addfontfeature{LetterSpace=12}\MakeUppercase}
  {}{0em}{}
\titleformat{\subsection}
  {\normalfont\fontsize{10pt}{13pt}\selectfont\sffamily\itshape}
  {}{0em}{}
\titlespacing*{\section}{0pt}{28pt}{10pt}
\titlespacing*{\subsection}{0pt}{18pt}{6pt}

% ── HEADERS & FOOTERS — Minimal ─────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[RO,LE]{\footnotesize\sffamily\color{captiongrey}\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\sffamily\color{captiongrey}\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── BLOCK QUOTES ────────────────────────────────────────────
\renewenvironment{quote}
  {\list{}{\leftmargin=0pt\rightmargin=2em}\item\relax\small\color{captiongrey}\setstretch{1.3}}
  {\endlist}

\setlist{nosep,leftmargin=1em}
\hypersetup{colorlinks=true,linkcolor=black!60,urlcolor=black!50,citecolor=black!60}

% ── Header includes (injected by compile pipeline) ─────────
$for(header-includes)$
$header-includes$
$endfor$

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\begin{titlepage}
\vspace*{\fill}\vspace*{72pt}
\begin{flushleft}
{\fontsize{36pt}{42pt}\selectfont\sffamily\fontseries{l}\selectfont $title$\par}
$if(author)$\vspace{24pt}{\fontsize{10pt}{14pt}\selectfont\sffamily\addfontfeature{LetterSpace=12}\MakeUppercase{\color{captiongrey} $author$}\par}$endif$
$if(date)$\vspace{6pt}{\footnotesize\sffamily\color{ghostgrey} $date$\par}$endif$
\end{flushleft}
\vspace*{\fill}
\end{titlepage}
$endif$

$body$

$if(bibliography)$
\newpage
\section*{Bibliography}
$bibliography$
$endif$

\end{document}
