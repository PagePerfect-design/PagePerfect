% Cinema — "The Hollywood Standard"
% Production-ready screenplay format — "1 Page = 1 Minute" rule
% TeX Gyre Cursor (Courier), strict margins, industry-standard spacing
% Target: Screenwriters, indie filmmakers, playwrights

\documentclass[12pt]{article}
\usepackage[
  paperwidth=8.5in,
  paperheight=11in,
  left=1.5in,
  right=1.0in,
  top=1.0in,
  bottom=1.0in
]{geometry}
\usepackage{fontspec}
\usepackage{setspace}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}

% ── TYPOGRAPHY — Courier 12pt is non-negotiable ─────────────
% TeX Gyre Cursor: Courier clone, industry standard for screenplays
\setmainfont{TeX Gyre Cursor}[Scale=1.0,Ligatures=TeX]
\setmonofont{TeX Gyre Cursor}[Scale=1.0]

% ── SPACING — Strict screenplay spacing ─────────────────────
% 12pt font, 12pt leading (single spaced)
\setstretch{1.0}
\setlength{\parindent}{0pt}
\setlength{\parskip}{12pt}
\raggedright

% ── HEADINGS — Screenplay hierarchy ─────────────────────────
% Sluglines (scene headings) = section = ALL CAPS, triple-spaced above
\makeatletter
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {24pt}%
  {12pt}%
  {\normalfont\normalsize\bfseries\MakeUppercase}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {12pt}%
  {6pt}%
  {\normalfont\normalsize\bfseries}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {12pt}%
  {3pt}%
  {\normalfont\normalsize}}
\makeatother

% ── HEADERS & FOOTERS ──────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\normalsize\thepage.}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}}

% ── BLOCK QUOTES — Dialogue blocks ─────────────────────────
% Centered narrower block for dialogue, mimicking screenplay format
\renewenvironment{quote}
  {\list{}{\leftmargin=1.0in\rightmargin=0.5in}\item\relax}
  {\endlist}

\hypersetup{colorlinks=false}

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\begin{center}
\vspace*{2in}
{\normalsize\MakeUppercase{$title$}\par}
$if(author)$\vspace{24pt}{\normalsize by\par}\vspace{12pt}{\normalsize $author$\par}$endif$
$if(date)$\vspace{24pt}{\normalsize $date$\par}$endif$
\end{center}
\thispagestyle{empty}
\newpage
$endif$

$body$

\end{document}
