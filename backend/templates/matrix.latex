% Matrix — "This is an Annual Report"
% Swiss Corporate system — McKinsey/BCG precision
% Fira Sans body with tabular figures, structured hierarchy, executive clarity
% Target: Annual reports, white papers, consulting decks, business docs

\documentclass[10pt]{article}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}
\usepackage{booktabs}

% ── TYPOGRAPHY — Fintech Precision ──────────────────────────
% Fira Sans: tabular lining figures for financial data alignment
\setmainfont{Fira Sans}[
  Ligatures=TeX,
  Numbers={Lining,Tabular}
]
\setmonofont{Fira Mono}[Scale=0.85]

% ── SPACING — Dense but legible ─────────────────────────────
\setstretch{1.4}
\setlength{\parindent}{0pt}
\setlength{\parskip}{8pt}

% ── COLORS ──────────────────────────────────────────────────
\definecolor{corpblue}{HTML}{191970}
\definecolor{rulegrey}{gray}{0.70}
\definecolor{zebrablue}{RGB}{230,238,255}

% ── SECTION HEADINGS — Corporate Weight Contrast ────────────
% H1: Black weight, large, tight tracking
\titleformat{\section}
  {\normalfont\sffamily\bfseries\fontsize{22pt}{26pt}\selectfont\addfontfeature{LetterSpace=-2}}
  {}{0em}{}

% H2: Bold, uppercase, tracked, navy
\titleformat{\subsection}
  {\normalfont\sffamily\bfseries\fontsize{12pt}{16pt}\selectfont\addfontfeature{LetterSpace=5}\color{corpblue}\MakeUppercase}
  {}{0em}{}

\titleformat{\subsubsection}
  {\normalfont\sffamily\bfseries\normalsize}{}{0em}{}

\titlespacing*{\section}{0pt}{20pt}{8pt}
\titlespacing*{\subsection}{0pt}{16pt}{6pt}
\titlespacing*{\subsubsection}{0pt}{10pt}{4pt}

% ── HEADERS & FOOTERS — Boardroom Style ─────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\sffamily\color{rulegrey}$if(title)$$title$$endif$}
\fancyhead[R]{\footnotesize\sffamily\thepage}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\headrule}{\color{rulegrey}\hrule height 0.5pt\relax}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\sffamily\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── BLOCK QUOTES — Executive Summary Style ──────────────────
\renewenvironment{quote}
  {\par\vspace{6pt}\noindent\hspace{0pt}%
   \begin{minipage}[t]{\dimexpr\textwidth-8pt}%
   \color{corpblue}\vrule width 4pt\hspace{8pt}%
   \begin{minipage}[t]{\dimexpr\textwidth-20pt}%
   \small\setstretch{1.2}\sffamily}
  {\end{minipage}\end{minipage}\par\vspace{6pt}}

% ── TABLES — Professional booktabs ─────────────────────────
\renewcommand{\arraystretch}{1.3}

\setlist{nosep,leftmargin=1.2em}
\hypersetup{colorlinks=true,linkcolor=corpblue,urlcolor=corpblue,citecolor=corpblue}

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\noindent{\color{rulegrey}\rule{\textwidth}{0.5pt}}
\vspace{8pt}
\begin{flushleft}
{\fontsize{28pt}{34pt}\selectfont\sffamily\bfseries\addfontfeature{LetterSpace=-2} $title$\par}
$if(author)$\vspace{8pt}{\normalsize\sffamily\color{rulegrey} $author$\par}$endif$
$if(date)$\vspace{4pt}{\footnotesize\sffamily\addfontfeature{LetterSpace=3}\MakeUppercase{\color{rulegrey} $date$}\par}$endif$
\end{flushleft}
\vspace{4pt}
\noindent{\color{rulegrey}\rule{\textwidth}{0.5pt}}
\vspace{12pt}
$endif$

$body$

$if(bibliography)$
\newpage
\section*{References}
$bibliography$
$endif$

\end{document}
