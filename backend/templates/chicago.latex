% Chicago — "The University Press Monograph"
% Strict academic template adhering to Chicago Manual of Style spirit
% ETBB (Bembo-like) body, true footnotes, deep indents, restrained hierarchy
% Target: Dissertations, monographs, history, theology, humanities

\documentclass[11pt]{book}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}
\usepackage[hang,flushmargin]{footmisc}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}

% ── TYPOGRAPHY ──────────────────────────────────────────────
% Body: ETbb (Bembo-like) — the "Scholar's Serif"
\setmainfont{ETbb}[
  Ligatures=TeX,
  Numbers=OldStyle
]
\setsansfont{Latin Modern Sans}[Scale=MatchLowercase]
\setmonofont{Latin Modern Mono}[Scale=MatchLowercase]

% ── SPACING ─────────────────────────────────────────────────
\setstretch{1.15}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\hyphenpenalty=50

% ── CHAPTER HEADINGS — Centered, Restrained ─────────────────
\titleformat{\chapter}[display]
  {\normalfont\centering}
  {\vspace*{30pt}{\normalsize\scshape\MakeUppercase{\chaptertitlename}\ \thechapter}}
  {10pt}
  {\Large\bfseries}

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\centering}
  {\vspace*{30pt}}
  {0pt}
  {\Large\bfseries}

\titlespacing*{\chapter}{0pt}{50pt}{30pt}

\titleformat{\section}{\normalfont\large\bfseries\centering}{}{0em}{}
\titleformat{\subsection}{\normalfont\normalsize\itshape}{}{0em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\scshape}{}{0em}{}
\titlespacing*{\section}{0pt}{24pt}{12pt}
\titlespacing*{\subsection}{0pt}{18pt}{8pt}
\titlespacing*{\subsubsection}{0pt}{14pt}{6pt}

% ── HEADERS & FOOTERS ──────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[CE]{\footnotesize\scshape $if(title)$$title$$endif$}
\fancyhead[CO]{\footnotesize\itshape\leftmark}
\fancyfoot[C]{\footnotesize\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── FOOTNOTES ───────────────────────────────────────────────
\renewcommand{\footnoterule}{\kern-3pt\hrule width 2in height 0.4pt\kern 2.6pt}

% ── BLOCK QUOTES ────────────────────────────────────────────
\renewenvironment{quote}
  {\list{}{\leftmargin=2em\rightmargin=2em}\item\relax\small\setstretch{1.05}}
  {\endlist}

% ── LISTS ───────────────────────────────────────────────────
\setlist{nosep,leftmargin=2em}

% ── HYPERLINKS ──────────────────────────────────────────────
\hypersetup{colorlinks=true,linkcolor=black,urlcolor=black!70,citecolor=black}

% ── Header includes (injected by compile pipeline) ─────────
$for(header-includes)$
$header-includes$
$endfor$

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\begin{titlepage}
\vspace*{\fill}
\begin{center}
{\LARGE\bfseries $title$\par}
$if(author)$\vspace{20pt}{\large $author$\par}$endif$
$if(date)$\vspace{10pt}{\normalsize $date$\par}$endif$
\end{center}
\vspace*{\fill}
\end{titlepage}
$endif$

$body$

$if(bibliography)$
\newpage
\section*{Bibliography}
$bibliography$
$endif$

\end{document}
