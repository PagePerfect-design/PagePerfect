% Thesis — "This is a Dissertation"
% Double-spaced academic format for university submission
% Latin Modern Roman body, numbered sections, declaration-ready structure
% Target: PhD/Masters theses, dissertations, capstone projects

\documentclass[12pt]{article}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}
\usepackage[hang,flushmargin]{footmisc}

% ── TYPOGRAPHY — Institutional Standard ───────────────────────
% Latin Modern Roman: the university default, compatible everywhere
\setmainfont{Latin Modern Roman}[Ligatures=TeX]
\setsansfont{Latin Modern Sans}[Scale=MatchLowercase]
\setmonofont{Latin Modern Mono}[Scale=MatchLowercase]

% ── SPACING — Double-spaced (university requirement) ──────────
\setstretch{2.0}
\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}
\hyphenpenalty=50

% ── SECTION HEADINGS — Numbered, Hierarchical ─────────────────
% Most universities require numbered sections: 1, 1.1, 1.1.1
\titleformat{\section}
  {\normalfont\Large\bfseries}
  {\thesection\quad}{0em}{}

\titleformat{\subsection}
  {\normalfont\large\bfseries}
  {\thesubsection\quad}{0em}{}

\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsubsection\quad}{0em}{}

\titlespacing*{\section}{0pt}{28pt}{14pt}
\titlespacing*{\subsection}{0pt}{22pt}{10pt}
\titlespacing*{\subsubsection}{0pt}{16pt}{8pt}

% ── HEADERS & FOOTERS — Page Number Only ──────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\footnotesize\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── FOOTNOTES ─────────────────────────────────────────────────
\renewcommand{\footnoterule}{\kern-3pt\hrule width 2in height 0.4pt\kern 2.6pt}

% ── BLOCK QUOTES — Indented, single-spaced ────────────────────
\renewenvironment{quote}
  {\list{}{\leftmargin=2em\rightmargin=2em}\item\relax\setstretch{1.15}\small}
  {\endlist}

\setlist{nosep,leftmargin=2em}
\hypersetup{colorlinks=true,linkcolor=blue!70!black,urlcolor=blue!60!black,citecolor=blue!70!black}

% ── Header includes (injected by compile pipeline) ───────────
$for(header-includes)$
$header-includes$
$endfor$

% ── DOCUMENT ──────────────────────────────────────────────────
\begin{document}

$if(title)$
\begin{center}
\vspace*{1in}
{\LARGE\bfseries $title$\par}
$if(author)$\vspace{24pt}{\large $author$\par}$endif$
$if(date)$\vspace{12pt}{\normalsize $date$\par}$endif$
\vspace{24pt}
\noindent\rule{3cm}{0.4pt}
\end{center}
\vspace{36pt}
$endif$

$body$

$if(bibliography)$
\newpage
\section*{References}
$bibliography$
$endif$

\end{document}
