% Heirloom — "The Modern Gastronomy Book"
% Cookbook format with mise-en-place grid separation
% DejaVu Serif headers + Fira Sans body, asymmetric recipe layout
% Target: Chefs, food bloggers, family recipe collections

\documentclass[11pt]{article}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}

% ── TYPOGRAPHY — Kitchen-Robust ─────────────────────────────
% DejaVu Serif for headers (slab-serif feel, robust)
% Fira Sans for body (clean, readable at small sizes)
\setmainfont{Fira Sans}[Ligatures=TeX]
\setsansfont{DejaVu Serif}[Scale=MatchLowercase]
\setmonofont{Fira Mono}[Scale=MatchLowercase]

% ── SPACING ─────────────────────────────────────────────────
\setstretch{1.4}
\setlength{\parindent}{0pt}
\setlength{\parskip}{8pt}

% ── COLORS ──────────────────────────────────────────────────
\definecolor{recipetitle}{HTML}{8B4513}
\definecolor{ingredientbg}{gray}{0.97}
\definecolor{rulegrey}{gray}{0.60}

% ── SECTION HEADINGS — Recipe Card Style ────────────────────
% Chapter = recipe name in warm slab-serif
\titleformat{\section}[block]
  {\vspace{8pt}{\color{rulegrey}\rule{\textwidth}{0.5pt}}\vspace{8pt}\normalfont\sffamily\bfseries\fontsize{20pt}{24pt}\selectfont\color{recipetitle}}
  {}{0em}{}

\titleformat{\subsection}
  {\normalfont\sffamily\bfseries\fontsize{12pt}{16pt}\selectfont\addfontfeature{LetterSpace=3}\MakeUppercase}
  {}{0em}{}

\titleformat{\subsubsection}
  {\normalfont\bfseries\normalsize}{}{0em}{}

\titlespacing*{\section}{0pt}{20pt}{8pt}
\titlespacing*{\subsection}{0pt}{14pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}

% ── HEADERS & FOOTERS ──────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\sffamily\color{rulegrey}$if(title)$$title$$endif$}
\fancyhead[R]{\footnotesize\sffamily\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\sffamily\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── BLOCK QUOTES — Ingredient/Note blocks ───────────────────
\renewenvironment{quote}
  {\par\vspace{4pt}\begin{minipage}[t]{\textwidth}%
   \setlength{\fboxsep}{10pt}%
   \colorbox{ingredientbg}{\begin{minipage}[t]{\dimexpr\textwidth-20pt}%
   \small\setstretch{1.2}}
  {\end{minipage}}\end{minipage}\par\vspace{4pt}}

% ── LISTS — Bold numbered steps ─────────────────────────────
\setlist[enumerate]{nosep,leftmargin=2em,font=\bfseries}
\setlist[itemize]{nosep,leftmargin=1.5em}

\hypersetup{colorlinks=true,linkcolor=recipetitle,urlcolor=recipetitle,citecolor=recipetitle}

% ── Header includes (injected by compile pipeline) ─────────
$for(header-includes)$
$header-includes$
$endfor$

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\begin{center}
\vspace*{24pt}
{\fontsize{28pt}{34pt}\selectfont\sffamily\bfseries\color{recipetitle} $title$\par}
\vspace{4pt}
{\color{rulegrey}\rule{2cm}{0.5pt}\par}
$if(author)$\vspace{8pt}{\normalsize\sffamily $author$\par}$endif$
$if(date)$\vspace{4pt}{\footnotesize\sffamily\color{rulegrey} $date$\par}$endif$
\end{center}
\vspace{16pt}
$endif$

$body$

$if(bibliography)$
\newpage
\section*{Sources}
$bibliography$
$endif$

\end{document}
