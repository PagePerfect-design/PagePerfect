% Operator — "The Engineering Manual"
% O'Reilly / Braun manual aesthetic — semantic interruptions, admonition blocks
% Fira Sans body + Fira Mono code, structured layout with sidenote margins
% Target: Developers, engineers, product makers, technical writers

\documentclass[10pt]{article}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}
\usepackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}

% ── TYPOGRAPHY — Machine Precision ──────────────────────────
% Fira Sans: the font of mankind and machines
\setmainfont{Fira Sans}[Scale=0.95,Ligatures=TeX]
\setmonofont{Fira Mono}[Scale=0.85]

% ── SPACING ─────────────────────────────────────────────────
\setstretch{1.4}
\setlength{\parindent}{0pt}
\setlength{\parskip}{8pt}

% ── COLORS ──────────────────────────────────────────────────
\definecolor{warningred}{HTML}{CC0000}
\definecolor{infoblue}{HTML}{0066CC}
\definecolor{codebg}{gray}{0.95}
\definecolor{rulegrey}{gray}{0.60}
\definecolor{headblue}{HTML}{003366}

% ── SECTION HEADINGS — Technical Hierarchy ──────────────────
\titleformat{\section}
  {\normalfont\sffamily\bfseries\fontsize{18pt}{22pt}\selectfont\color{headblue}}
  {\thesection\quad}{0em}{}

\titleformat{\subsection}
  {\normalfont\sffamily\bfseries\fontsize{13pt}{16pt}\selectfont\color{headblue}}
  {\thesubsection\quad}{0em}{}

\titleformat{\subsubsection}
  {\normalfont\sffamily\bfseries\normalsize}{}{0em}{}

\titlespacing*{\section}{0pt}{20pt}{8pt}
\titlespacing*{\subsection}{0pt}{14pt}{6pt}
\titlespacing*{\subsubsection}{0pt}{10pt}{4pt}

% ── ADMONITION BOXES — Warning / Info / Note ────────────────
\newtcolorbox{ppwarning}{
  enhanced,breakable,
  colback=warningred!5,colframe=white,
  borderline west={3pt}{0pt}{warningred},
  sharp corners,boxrule=0pt,left=8pt,right=8pt,top=6pt,bottom=6pt,
  before upper={\textbf{\color{warningred}Warning}\par\smallskip}
}

\newtcolorbox{ppinfo}{
  enhanced,breakable,
  colback=infoblue!5,colframe=white,
  borderline west={3pt}{0pt}{infoblue},
  sharp corners,boxrule=0pt,left=8pt,right=8pt,top=6pt,bottom=6pt,
  before upper={\textbf{\color{infoblue}Info}\par\smallskip}
}

\newtcolorbox{ppcode}{
  enhanced,breakable,
  colback=codebg,colframe=white,
  sharp corners,boxrule=0pt,left=8pt,right=8pt,top=6pt,bottom=6pt
}

% ── HEADERS & FOOTERS ──────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\sffamily\color{rulegrey}$if(title)$$title$$endif$}
\fancyhead[R]{\footnotesize\sffamily\thepage}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\headrule}{\color{rulegrey}\hrule height 0.5pt\relax}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\sffamily\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── BLOCK QUOTES — Info callout ─────────────────────────────
\renewenvironment{quote}
  {\begin{ppinfo}}
  {\end{ppinfo}}

% ── CODE BLOCKS ─────────────────────────────────────────────
% Override Pandoc's code highlighting background
\definecolor{shadecolor}{gray}{0.95}

% ── LISTS ───────────────────────────────────────────────────
\setlist{nosep,leftmargin=1.5em}
\setlist[enumerate]{font=\bfseries\sffamily}

\hypersetup{colorlinks=true,linkcolor=headblue,urlcolor=infoblue,citecolor=headblue}

% ── Header includes (injected by compile pipeline) ─────────
$for(header-includes)$
$header-includes$
$endfor$

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\begin{flushleft}
\vspace*{16pt}
{\fontsize{26pt}{32pt}\selectfont\sffamily\bfseries\color{headblue} $title$\par}
\vspace{4pt}
\noindent{\color{headblue}\rule{3cm}{2pt}\par}
$if(author)$\vspace{8pt}{\normalsize\sffamily $author$\par}$endif$
$if(date)$\vspace{4pt}{\footnotesize\sffamily\color{rulegrey} $date$\par}$endif$
\end{flushleft}
\vspace{12pt}
$endif$

$body$

$if(bibliography)$
\newpage
\section*{References}
$bibliography$
$endif$

\end{document}
