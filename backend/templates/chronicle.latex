% Chronicle — "This is Journalism"
% Swiss International Style editorial system — Neue Grafik / Vignelli
% TeX Gyre Heros (Helvetica) body, heavy rules, lede blocks, ragged right
% Target: Non-fiction, journalism, technical manuals, reports

\documentclass[11pt]{article}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}
\usepackage{ragged2e}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}

% ── TYPOGRAPHY — Swiss International Style ──────────────────
% Body: TeX Gyre Heros (Helvetica clone) — neutral, dense, authoritative
\setmainfont{TeX Gyre Heros}[Scale=0.92,Ligatures=TeX]
\setmonofont{Fira Mono}[Scale=MatchLowercase]

% Ragged right — prevents river-gaps in sans-serif justified text
\RaggedRight
\hyphenpenalty=200

% ── SPACING — Block paragraphs ──────────────────────────────
\setstretch{1.4}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.15in}

% ── COLORS ──────────────────────────────────────────────────
\definecolor{rulegrey}{gray}{0.35}
\definecolor{numgrey}{gray}{0.65}

% ── SECTION HEADINGS — Newsroom Style ───────────────────────
\titleformat{\section}[block]
  {\vspace{8pt}{\color{black}\rule{\textwidth}{3pt}}\vspace{6pt}\filright\sffamily\bfseries\fontsize{24pt}{28pt}\selectfont}
  {}{0em}{}

\titleformat{\subsection}[block]
  {\vspace{4pt}{\color{rulegrey}\rule{\textwidth}{0.5pt}}\vspace{4pt}\sffamily\bfseries\fontsize{14pt}{17pt}\selectfont\addfontfeature{LetterSpace=5}\MakeUppercase}
  {}{0em}{}

\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\sffamily}{}{0em}{}
\titlespacing*{\section}{0pt}{20pt}{10pt}
\titlespacing*{\subsection}{0pt}{16pt}{6pt}
\titlespacing*{\subsubsection}{0pt}{10pt}{4pt}

% ── HEADERS & FOOTERS ──────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\sffamily\addfontfeature{LetterSpace=3}\MakeUppercase{$if(title)$$title$$endif$}}
\fancyhead[R]{\footnotesize\sffamily\thepage}
\renewcommand{\headrulewidth}{2pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\sffamily\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── BLOCK QUOTES — Pull Quote Style ────────────────────────
\renewenvironment{quote}
  {\list{}{\leftmargin=0pt\rightmargin=0pt}\item\relax
   \leavevmode\llap{\color{black}\vrule width 3pt\hspace{1em}}%
   \sffamily\bfseries\large\setstretch{1.2}}
  {\endlist}

\setlist{nosep,leftmargin=1.2em}
\hypersetup{colorlinks=true,linkcolor=black,urlcolor=black!60,citecolor=black}

% ── Header includes (injected by compile pipeline) ─────────
$for(header-includes)$
$header-includes$
$endfor$

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\noindent{\color{black}\rule{\textwidth}{4pt}}
\vspace{8pt}
\begin{flushleft}
{\fontsize{36pt}{40pt}\selectfont\sffamily\bfseries $title$\par}
$if(author)$\vspace{6pt}{\large\sffamily\color{rulegrey} $author$\par}$endif$
$if(date)$\vspace{2pt}{\footnotesize\sffamily\addfontfeature{LetterSpace=3}\MakeUppercase{\color{numgrey} $date$}\par}$endif$
\end{flushleft}
\vspace{4pt}
\noindent{\color{black}\rule{\textwidth}{1pt}}
\vspace{12pt}
$endif$

$body$

$if(bibliography)$
\vspace{20pt}
\noindent{\color{black}\rule{\textwidth}{2pt}}
\vspace{8pt}
\section*{References}
$bibliography$
$endif$

\end{document}
