% Paperback — "This is a Netflix Adaptation"
% Commercial fiction template — NYT Bestseller aesthetic
% Alegreya Sans (humanist) body + condensed display, cinematic chapter drops
% Target: Thrillers, modern romance, fiction, page-turners

\documentclass[11pt]{book}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}

% ── TYPOGRAPHY — Humanist Sans for Fiction ──────────────────
% Alegreya Sans: calligraphic sans-serif — warm, literary, story-like
\setmainfont{Alegreya Sans}[Ligatures=TeX]
\setsansfont{TeX Gyre Heros}[Scale=MatchLowercase,Ligatures=TeX]
\setmonofont{DejaVu Sans Mono}[Scale=MatchLowercase]

% ── SPACING — Fiction standard ──────────────────────────────
\setstretch{1.35}
\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}
\hyphenpenalty=100

% ── COLORS ──────────────────────────────────────────────────
\definecolor{chapnum}{gray}{0.85}

% ── CHAPTER HEADINGS — Cinematic Title Card ─────────────────
% Dramatic drop with massive grey number + bold title
% NOTE: \vspace* belongs in \titlespacing* (before-sep), NOT inside the label.
% Putting \vspace* in the label triggers "titlesec: entered in horizontal mode".
\titleformat{\chapter}[display]
  {\normalfont\raggedleft}
  {{\fontsize{60pt}{60pt}\selectfont\sffamily\bfseries\color{chapnum}\thechapter}}
  {-8pt}
  {\Large\bfseries}

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\raggedleft}
  {}
  {0pt}
  {\Large\bfseries}

\titlespacing*{\chapter}{0pt}{48pt}{24pt}

\titleformat{\section}{\normalfont\large\bfseries}{}{0em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{}{0em}{}
\titlespacing*{\section}{0pt}{18pt}{8pt}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}

% ── SCENE BREAKS ────────────────────────────────────────────
% Centered asterisks for time/scene transitions
\newcommand{\scenebreak}{\par\vspace{12pt}\noindent\hfil{\large *\quad *\quad *}\hfil\par\vspace{12pt}}

% ── HEADERS & FOOTERS — Running Heads ───────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\footnotesize\sffamily\scshape $if(title)$$title$$endif$}
\fancyhead[RO]{\footnotesize\sffamily\itshape\leftmark}
\fancyfoot[C]{\footnotesize\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── BLOCK QUOTES ────────────────────────────────────────────
\renewenvironment{quote}
  {\list{}{\leftmargin=1.5em\rightmargin=1.5em}\item\relax\itshape\setstretch{1.2}}
  {\endlist}

\setlist{nosep,leftmargin=1.5em}
\hypersetup{colorlinks=true,linkcolor=black,urlcolor=black!60,citecolor=black}

% ── Header includes (injected by compile pipeline) ─────────
$for(header-includes)$
$header-includes$
$endfor$

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\begin{titlepage}
\vspace*{\fill}
\begin{flushright}
{\fontsize{32pt}{38pt}\selectfont\bfseries $title$\par}
$if(author)$\vspace{16pt}{\large $author$\par}$endif$
\end{flushright}
\vspace*{\fill}
\end{titlepage}
$endif$

$body$

$if(bibliography)$
\newpage
\section*{Bibliography}
$bibliography$
$endif$

\end{document}
