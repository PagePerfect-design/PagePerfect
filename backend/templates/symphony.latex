% Symphony Academic — "The Van de Graaf Canon"
% Classical academic design inspired by Gutenberg/Tschichold proportions
% EB Garamond body, ornamental chapter openings, microtype protrusion
% Target: Dissertations, literary criticism, humanities monographs

\documentclass[12pt]{book}
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{enumitem}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}

% ── TYPOGRAPHY ──────────────────────────────────────────────
% Body: EB Garamond — humanist serif, 16th-century French elegance
\setmainfont{EB Garamond}[
  Ligatures=TeX,
  Numbers=OldStyle
]
\setsansfont{Libertinus Sans}[Scale=MatchLowercase]
\setmonofont{DejaVu Sans Mono}[Scale=MatchLowercase]

% Microtype — optical margin alignment (protrusion) + font expansion
\UseMicrotypeSet[protrusion]{basicmath}

% ── SPACING ─────────────────────────────────────────────────
% 12pt baseline, 14pt leading (academic standard)
\setstretch{1.15}
\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}

% ── COLORS ──────────────────────────────────────────────────
\definecolor{oxblood}{HTML}{800020}
\definecolor{chaptergrey}{gray}{0.45}

% ── CHAPTER HEADINGS — Ornamental Style ─────────────────────
\titleformat{\chapter}[display]
  {\normalfont\centering}
  {{\fontsize{11pt}{11pt}\selectfont\scshape\color{chaptergrey}\chaptertitlename\ \thechapter}}
  {12pt}
  {\LARGE\bfseries\scshape\color{oxblood}}
  [\vspace{4pt}{\centering\rule{1cm}{0.4pt}}\vspace{8pt}]

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\centering}
  {}
  {0pt}
  {\LARGE\bfseries\scshape\color{oxblood}}
  [\vspace{4pt}{\centering\rule{1cm}{0.4pt}}\vspace{8pt}]

\titlespacing*{\chapter}{0pt}{70pt}{30pt}

% Section headings — restrained serif hierarchy
\titleformat{\section}
  {\normalfont\Large\bfseries}{}{0em}{}
\titleformat{\subsection}
  {\normalfont\large\itshape}{}{0em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\scshape}{}{0em}{}

\titlespacing*{\section}{0pt}{24pt}{12pt}
\titlespacing*{\subsection}{0pt}{18pt}{8pt}
\titlespacing*{\subsubsection}{0pt}{14pt}{6pt}

% ── HEADERS & FOOTERS ──────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\footnotesize\thepage\quad\textsc{$if(title)$$title$$endif$}}
\fancyhead[RO]{\footnotesize\textit{\leftmark}\quad\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\thepage}\renewcommand{\headrulewidth}{0pt}}

% ── BLOCK QUOTES ────────────────────────────────────────────
\renewenvironment{quote}
  {\list{}{\leftmargin=2em\rightmargin=2em}\item\relax\small\setstretch{1.05}}
  {\endlist}

% ── FOOTNOTES ───────────────────────────────────────────────
\usepackage[hang,flushmargin]{footmisc}

% ── LISTS ───────────────────────────────────────────────────
\setlist{nosep,leftmargin=1.5em}

% ── HYPERLINKS ──────────────────────────────────────────────
\hypersetup{
  colorlinks=true,
  linkcolor=oxblood,
  urlcolor=oxblood,
  citecolor=oxblood
}

% ── Header includes (injected by compile pipeline) ─────────
$for(header-includes)$
$header-includes$
$endfor$

% ── DOCUMENT ────────────────────────────────────────────────
\begin{document}

$if(title)$
\begin{titlepage}
\vspace*{\fill}
\begin{center}
{\fontsize{28pt}{34pt}\selectfont\scshape\color{oxblood} $title$\par}
\vspace{16pt}
{\centering\rule{2cm}{0.4pt}\par}
$if(author)$
\vspace{12pt}
{\large\itshape $author$\par}
$endif$
$if(date)$
\vspace{8pt}
{\small $date$\par}
$endif$
\end{center}
\vspace*{\fill}
\end{titlepage}
$endif$

$body$

$if(bibliography)$
\newpage
\section*{References}
$bibliography$
$endif$

\end{document}
