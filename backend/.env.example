# Server
PORT=4000
NODE_ENV=development

# CORS (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000

# PocketBase (self-hosted via Coolify)
POCKETBASE_URL=https://pb.pageperfect.studio
POCKETBASE_ADMIN_EMAIL=admin@pageperfect.studio
POCKETBASE_ADMIN_PASSWORD=your-admin-password

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PUBLISHER=price_...
STRIPE_PRICE_STUDIO=price_...

# Resend (configures PocketBase SMTP for verification/reset emails)
RESEND_API_KEY=re_...
RESEND_FROM=noreply@pageperfect.studio

# Compile limits
MAX_MD_BYTES=2097152
COMPILE_TIMEOUT_MS=45000
